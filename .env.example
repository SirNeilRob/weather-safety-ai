# Copy to .env and adjust. Real environment variables always win over this file.

# ---------------------------------------------------------------- Swarm (remote)
# Base URL only, no trailing slash. Leave empty to run fully offline.
SWARM_BASE_URL=
SWARM_API_KEY=
# Endpoint path appended to the base URL.
SWARM_ENDPOINT=/v1/chat/completions
SWARM_MODEL=
SWARM_TIMEOUT=20
SWARM_MAX_RETRIES=2

# Optional. If set, results produced offline are pushed here when the link
# returns. If not set, offline results stay marked "pending" and the backlog is
# reported in /v1/health instead of being silently dropped.
SWARM_SYNC_ENDPOINT=

# ---------------------------------------------------------------- Connectivity
# Any HTTP status below 500 counts as "link is up".
# Add the real Swarm health endpoint here once you know it.
PROBE_URLS=https://1.1.1.1,https://www.gstatic.com/generate_204
PROBE_INTERVAL=5
PROBE_TIMEOUT=3
# Consecutive failures before the app switches to the offline engine.
OFFLINE_AFTER_FAILURES=2
# Consecutive successes before it trusts the link again.
ONLINE_AFTER_SUCCESSES=1
PROBE_ON_STARTUP=true

# ---------------------------------------------------------------- Local engine
# builtin = deterministic stdlib engine (default)
# ollama  = local LLM through Ollama, still no internet
LOCAL_ENGINE=builtin
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ---------------------------------------------------------------- Queue
DB_PATH=data/sharkbyte.db
WORKER_COUNT=2
MAX_ATTEMPTS=3
JOB_TIMEOUT=60

# ---------------------------------------------------------------- Sync
SYNC_INTERVAL=10
SYNC_BATCH=20

# ---------------------------------------------------------------- Resilience
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN=30

# ---------------------------------------------------------------- Server / demo
HOST=0.0.0.0
PORT=8000
# true = behave as if the network is down, without touching the network.
FORCED_OFFLINE=false
